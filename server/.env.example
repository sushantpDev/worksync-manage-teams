PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worksync?appName=empdb
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173

# Email (invitations, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WorkSync <noreply@worksync.app>
INVITATION_EXPIRY_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=30

# Rate limiting (auth endpoints)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MINUTES=60
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_FORGOT_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_FORGOT_RATE_LIMIT_MAX=5
AUTH_RESET_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RESET_RATE_LIMIT_MAX=10

# Trust proxy for correct client IP behind reverse proxy (unset = disabled)
# TRUST_PROXY=1

TASK_ATTACHMENT_MAX_SIZE_MB=10

# Cloudinary (profile avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
